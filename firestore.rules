rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // Each person's profile, food log, and weight log: only that person.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Household: shared custom foods, saved meals, and recipes.
    match /households/{hid} {
      allow get: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && request.resource.data.members == [request.auth.uid];
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members ||
        // Joining with the code: may only add yourself to the member list.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members
          && resource.data.members.size() < 6)
      );
      allow list, delete: if false;

      match /{sub=**} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(db)/documents/households/$(hid)).data.members;
      }
    }
  }
}
